CAPI=2:
name: "akerlund::cordic:1.0.0"
description: "CORDIC algorithm core with AXI4-Stream interface"

filesets:
  rtl:
    files:
      - rtl/cordic_atan_radian_table_pkg.sv
      - rtl/cordic_axi4s_types_pkg.sv
      - rtl/cordic_radian_core.sv
      - rtl/cordic_radian_top.sv
      - rtl/cordic_axi4s_if.sv
    file_type: systemVerilogSource

  synth_ooc:
    files:
      - constraints/vivado_ooc.tcl
    file_type: tclSource

parameters:
  AXI_DATA_WIDTH_P:
    datatype: int
    default: 16
    paramtype: vlogparam
  AXI_ID_WIDTH_P:
    datatype: int
    default: 4
    paramtype: vlogparam
  NR_OF_STAGES_P:
    datatype: int
    default: 16
    paramtype: vlogparam

targets:
  default:
    filesets:
      - rtl

  synth_vivado:
    flow: vivado
    flow_options:
      # Zynq-7020, the part the utilisation figures in the README describe.
      part: xc7z020clg484-1
    filesets:
      - rtl
      - synth_ooc
    parameters:
      - AXI_DATA_WIDTH_P
      - AXI_ID_WIDTH_P
      - NR_OF_STAGES_P
    toplevel: cordic_axi4s_if

  rtl:
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - --timing
        - --error-limit
        - "0"
        - -Werror-IMPLICIT
        - -Werror-BLKSEQ
        - -Werror-LATCH
        - -Werror-CASEINCOMPLETE
        - -Wno-fatal
        - -Wno-UNUSEDSIGNAL
        - -Wno-PINCONNECTEMPTY
    filesets:
      - rtl
    parameters:
      - AXI_DATA_WIDTH_P
      - AXI_ID_WIDTH_P
      - NR_OF_STAGES_P
    toplevel: cordic_axi4s_if
